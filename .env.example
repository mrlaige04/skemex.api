# Copy to .env for local docker compose (optional overrides).

POSTGRES_USER=skemex
POSTGRES_PASSWORD=skemex
POSTGRES_DB=skemex

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

JWT_SECRET=CHANGE_ME_MINIMUM_32_CHARACTERS_LONG_SECRET!
SUPERADMIN_EMAIL=admin@example.com
SUPERADMIN_PASSWORD=ChangeMe123!

# Optional: public URLs for <img src> when using MinIO (see docker-compose.yaml).
# PUBLIC_BRANDING_BLOB_BASE_URL=http://localhost:9000/skemex-branding
# PUBLIC_FILES_BLOB_BASE_URL=

# AI / Ollama — ~4 GiB RAM: llama3.2:1b. More RAM: llama3.2:3b or llama3.
# Tree depth/nodes are configured per project in Project Settings → AI.
OLLAMA_MODEL=llama3.2:1b
# OLLAMA_BASE_URL=http://ollama:11434
# OLLAMA_TIMEOUT_SECONDS=600
# OLLAMA_KEEP_ALIVE=5m
