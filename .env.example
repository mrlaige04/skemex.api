# Copy to .env for local docker compose (optional overrides).

POSTGRES_USER=skemex
POSTGRES_PASSWORD=skemex
POSTGRES_DB=skemex

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

JWT_SECRET=CHANGE_ME_MINIMUM_32_CHARACTERS_LONG_SECRET!
SUPERADMIN_EMAIL=admin@example.com
SUPERADMIN_PASSWORD=ChangeMe123!

# Google Gemini embeddings for document vectorization (RAG ingestion).
# EMBEDDINGS__APIKEY=your-gemini-api-key

# Optional: public URLs for <img src> when using MinIO (see docker-compose.yaml).
# PUBLIC_BRANDING_BLOB_BASE_URL=http://localhost:9000/skemex-branding
# PUBLIC_FILES_BLOB_BASE_URL=

# Seq (prod compose UI: http://host:5341)
# SEQ_ADMIN_USERNAME=admin
# SEQ_ADMIN_PASSWORD=change-me-seq-admin
# After first Seq start with auth enabled: open UI → Settings → API keys → create ingestion key,
# then set SEQ_API_KEY (GitHub secret / .env) and redeploy/restart api.
# SEQ_API_KEY=
# Note: SEQ_ADMIN_* only apply on first init of the skemex_seq volume.
