{
  "App": {
    "FrontendBaseUrl": ""
  },
  "Storage": {
    "Provider": "Production",
    "PublicBrandingBlobBaseUrl": "",
    "PublicFilesBlobBaseUrl": "",
    "PublicProjectDocumentsBlobBaseUrl": "",
    "PublicIssueAttachmentsBlobBaseUrl": "",
    "PublicAiChatAttachmentsBlobBaseUrl": "",
    "ProfileImages": {
      "Bucket": "skemex-branding"
    },
    "Minio": {
      "Endpoint": "http://minio:9000",
      "PublicEndpoint": "",
      "BrandingBucket": "skemex-branding",
      "FilesBucket": "skemex-files",
      "ProjectDocumentsBucket": "project-documents",
      "IssueAttachmentsBucket": "issues-attachments",
      "AiChatAttachmentsBucket": "ai-chat-attachments",
      "PresignedDownloadExpirySeconds": 3600
    }
  },
  "Smtp": {
    "Server": "smtp.zoho.eu",
    "Port": 587,
    "SenderName": "Skemex",
    "SenderEmail": "no-reply@skemex.online",
    "Username": "",
    "Password": "",
    "EnableSsl": true,
    "TimeoutSeconds": 30
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.Seq" ],
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "Seq",
        "Args": {
          "serverUrl": "http://seq",
          "apiKey": ""
        }
      }
    ]
  }
}
